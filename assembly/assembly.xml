<assembly>
    <id>release</id>
    <formats>
        <format>tar.gz</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>
    <moduleSets>
        <moduleSet>
            <includes>
                <include>org.apache.realtime:zeus-app</include>
            </includes>
            <binaries>
                <outputDirectory>lib</outputDirectory>
                <includeDependencies>true</includeDependencies>
                <unpack>false</unpack>
            </binaries>
        </moduleSet>
    </moduleSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <includes>
                <include>org.apache.realtime:zeus-app:jar</include>
            </includes>
            <scope>runtime</scope>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>${project.parent.basedir}/config</directory>
            <outputDirectory>config</outputDirectory>
            <includes>
                <include>**/*.ini</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${project.parent.basedir}/cli</directory>
            <outputDirectory>cli</outputDirectory>
            <directoryMode>0777</directoryMode>
            <includes>
                <include>*.sh</include>
            </includes>
            <fileMode>0777</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>${project.parent.basedir}/sqls</directory>
            <outputDirectory>sql</outputDirectory>
            <directoryMode>0777</directoryMode>
            <includes>
                <include>*.sql</include>
            </includes>
            <fileMode>0777</fileMode>
            <lineEnding>unix</lineEnding>
        </fileSet>
    </fileSets>
</assembly>